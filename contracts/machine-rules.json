{
  "schemaVersion": "0.3.0",
  "productionPhases": [
    {"phase": "P0", "state": "INGESTED"},
    {"phase": "P1", "state": "REPLACEMENT_PLANNED"},
    {"phase": "P2", "state": "TEMPLATE_IMAGE_APPROVED"},
    {"phase": "P3", "state": "TEMPLATE_ANALYZED"},
    {"phase": "P4", "state": "EDITABLE_SPEC_COMPILED"},
    {"phase": "P5", "state": "TEMPLATE_COMPILED"},
    {"phase": "P6", "state": "STATIC_VALIDATED"},
    {"phase": "P7", "state": "ASSET_UPLOADED"},
    {"phase": "P8", "state": "FINALIZED"}
  ],
  "initialState": "STARTED",
  "resultStates": {
    "completed": "FINALIZED",
    "needs_input": "NEEDS_REVIEW",
    "blocked": "BLOCKED",
    "failed": "FAILED"
  },
  "sourceCategories": {
    "ordinaryPerson": "ordinary_person",
    "publicFigure": "public_figure",
    "historicalFigure": "historical_figure",
    "classicArtSubject": "classic_art_subject",
    "knownCharacterIp": "known_character_ip",
    "genericPerson": "generic_person",
    "genericAnimal": "generic_animal",
    "genericObject": "generic_object",
    "genericFood": "generic_food",
    "textContent": "text_content",
    "sceneAttribute": "scene_attribute",
    "unknownCategory": "unknown"
  },
  "strategySources": {
    "perImageDecision": "per_image",
    "batchDecision": "batch",
    "autonomousDecision": "autonomous"
  },
  "replacementStrategyContract": {
    "allowedFields": [
      "policyId",
      "policyVersion",
      "replacementValue",
      "replacementCategory",
      "preserve",
      "forbidValues"
    ],
    "pairedFields": [["replacementValue", "replacementCategory"]],
    "listFields": ["preserve", "forbidValues"],
    "actionFields": ["replacementValue", "preserve", "forbidValues"]
  },
  "visualDimensions": ["medium", "form", "edge", "colorAndShading", "surface", "composition"],
  "visualHardGates": [
    "replacementComplete",
    "dependencyClosureComplete",
    "mechanismPreserved",
    "contactGeometryValid",
    "watermarkFree",
    "legacyIdentityFree"
  ],
  "formalProjection": {
    "topLevel": [
      "key",
      "status",
      "title",
      "description",
      "imageSize",
      "promptTemplate",
      "inputSchema",
      "promptEnhancement",
      "metadata",
      "cover",
      "referenceImage"
    ],
    "metadata": ["tags", "needsReview"],
    "forbiddenKeys": [
      "coverUrl",
      "candidateScope",
      "runtimeRequirements",
      "templateSource",
      "inputSemantics",
      "suggestionRationales",
      "optimizationAudit"
    ]
  },
  "prompt": {
    "instructionMaxCharacters": 150,
    "forbiddenProductionTerms": ["候选图", "来源图", "原图", "作者源", "revision", "审核"],
    "forbiddenInstructionTerms": ["禁止", "不要", "不得", "清除", "具体IP", "候选图", "来源图"]
  },
  "semanticAuditChecks": [
    "promptResolutionsNatural",
    "hiddenOpenAxesRemainEditable",
    "titleSurvivesMaximumDifference",
    "slotSuggestionsSameAxisAndGranularity"
  ],
  "slotBudget": {"minimum": 2, "normal": 3, "maximum": 5, "singleSlotRequiresEvidence": true},
  "identifiers": {
    "productionItemIdPattern": "^[a-z][a-z0-9-]{1,127}$",
    "imageExtensionPattern": "^\\.[a-z0-9]{1,10}$"
  },
  "errorCodes": {
    "invalidProductionRequest": "INVALID_PRODUCTION_REQUEST",
    "productionItemIntegrityFailure": "PRODUCTION_ITEM_INTEGRITY_FAILURE",
    "explicitStrategyConflict": "EXPLICIT_STRATEGY_CONFLICT",
    "riskNeedsReview": "NEEDS_REVIEW",
    "unknownCategory": "AUTONOMOUS_TARGET_UNKNOWN",
    "noCompatibleReplacement": "NO_COMPATIBLE_REPLACEMENT",
    "visualHardFailure": "VISUAL_HARD_FAILURE",
    "contractFailure": "STATIC_CONTRACT_FAILURE",
    "externalFailure": "EXTERNAL_ADAPTER_FAILURE",
    "immutableConflict": "IMMUTABLE_ARTIFACT_CONFLICT"
  },
  "historicalExperienceEvidence": ["E01", "E04", "E05", "E06", "E07", "E10", "E11", "E19", "E21", "E25", "E27", "E35", "E36", "E38"]
}
