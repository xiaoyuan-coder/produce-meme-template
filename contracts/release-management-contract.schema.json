{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.internal/schemas/produce-meme-template/release-management-contract.json",
  "title": "ReleaseManagementContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lockFileName",
    "lockArtifactType",
    "lockSchemaVersion",
    "runtimeIgnoredDirectoryNames",
    "runtimeIgnoredSuffixes",
    "buildValidationRunnerRelativePath",
    "smokeFixtureRelativePath",
    "validationTimeoutSeconds",
    "errorCodes",
    "lockFields",
    "fileFields",
    "diagnosticFields",
    "installRecordFields",
    "migrationFields",
    "productionPinArtifactType",
    "productionPinFields",
    "productionPinSkillFields",
    "productionPinGalleryFields",
    "legacyProductionPinRequiredFieldRoles",
    "validatorRelativePath",
    "replacementSpecRelativePath",
    "replacementSpecVersion",
    "gallerySnapshotRelativePath",
    "gallerySnapshotMetadataRelativePath",
    "installLayout",
    "migrationArtifactType",
    "migrationFilePattern",
    "migrationInvalidateFromPhaseIndex"
  ],
  "properties": {
    "lockFileName": { "$ref": "#/$defs/relativePath" },
    "lockArtifactType": { "$ref": "#/$defs/nonEmptyString" },
    "lockSchemaVersion": { "$ref": "#/$defs/semver" },
    "runtimeIgnoredDirectoryNames": { "$ref": "#/$defs/uniqueStrings" },
    "runtimeIgnoredSuffixes": { "$ref": "#/$defs/uniqueStrings" },
    "buildValidationRunnerRelativePath": { "$ref": "#/$defs/relativePath" },
    "smokeFixtureRelativePath": { "$ref": "#/$defs/relativePath" },
    "validationTimeoutSeconds": { "type": "integer", "minimum": 600 },
    "errorCodes": { "$ref": "#/$defs/errorCodes" },
    "lockFields": { "$ref": "#/$defs/lockFields" },
    "fileFields": { "$ref": "#/$defs/fileFields" },
    "diagnosticFields": { "$ref": "#/$defs/diagnosticFields" },
    "installRecordFields": { "$ref": "#/$defs/installRecordFields" },
    "migrationFields": { "$ref": "#/$defs/migrationFields" },
    "productionPinArtifactType": { "$ref": "#/$defs/nonEmptyString" },
    "productionPinFields": { "$ref": "#/$defs/productionPinFields" },
    "productionPinSkillFields": { "$ref": "#/$defs/productionPinSkillFields" },
    "productionPinGalleryFields": { "$ref": "#/$defs/productionPinGalleryFields" },
    "legacyProductionPinRequiredFieldRoles": { "$ref": "#/$defs/uniqueStrings" },
    "validatorRelativePath": { "$ref": "#/$defs/relativePath" },
    "replacementSpecRelativePath": { "$ref": "#/$defs/relativePath" },
    "replacementSpecVersion": { "$ref": "#/$defs/semver" },
    "gallerySnapshotRelativePath": { "$ref": "#/$defs/relativePath" },
    "gallerySnapshotMetadataRelativePath": { "$ref": "#/$defs/relativePath" },
    "installLayout": { "$ref": "#/$defs/installLayout" },
    "migrationArtifactType": { "$ref": "#/$defs/nonEmptyString" },
    "migrationFilePattern": { "type": "string", "pattern": "\\{revision\\}" },
    "migrationInvalidateFromPhaseIndex": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "errorCodes": {
      "$ref": "#/$defs/roleMap",
      "required": ["invalidReleaseMetadata", "invalidGitCommit", "sourceGitMismatch", "sourceFileSetMismatch", "releaseValidationFailure", "dirtyWorktree", "releaseAlreadyExists", "missingReleaseFile", "invalidReleaseLock", "mutableReleaseRuntime", "extraInstallFile", "fileDigestMismatch", "releaseDigestMismatch", "mixedVersion", "installVersionExists", "installPointerConflict", "installPathConflict", "invalidInstallRecord", "productionPinMismatch", "invalidSourceRuntime", "invalidProductionPin", "invalidProductionManifest", "newRuntimeInvalid", "immutableMigrationConflict", "releaseReadinessRequired", "invalidReviewComparisonBase"],
      "propertyNames": { "enum": ["invalidReleaseMetadata", "invalidGitCommit", "sourceGitMismatch", "sourceFileSetMismatch", "releaseValidationFailure", "dirtyWorktree", "releaseAlreadyExists", "missingReleaseFile", "invalidReleaseLock", "mutableReleaseRuntime", "extraInstallFile", "fileDigestMismatch", "releaseDigestMismatch", "mixedVersion", "installVersionExists", "installPointerConflict", "installPathConflict", "invalidInstallRecord", "productionPinMismatch", "invalidSourceRuntime", "invalidProductionPin", "invalidProductionManifest", "newRuntimeInvalid", "immutableMigrationConflict", "releaseReadinessRequired", "invalidReviewComparisonBase"] }
    },
    "lockFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["artifactType", "lockSchemaVersion", "skillName", "skillVersion", "artifactSchemaVersion", "galleryContractVersion", "galleryContractSha256", "gitCommit", "reviewComparisonBaseGitCommit", "builtAt", "files", "contentDigest", "releaseDigest"],
      "propertyNames": { "enum": ["artifactType", "lockSchemaVersion", "skillName", "skillVersion", "artifactSchemaVersion", "galleryContractVersion", "galleryContractSha256", "gitCommit", "reviewComparisonBaseGitCommit", "builtAt", "files", "contentDigest", "releaseDigest"] }
    },
    "fileFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["path", "sha256", "bytes"],
      "propertyNames": { "enum": ["path", "sha256", "bytes"] }
    },
    "diagnosticFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["runtimeRoot", "installSource", "skillVersion", "artifactSchemaVersion", "galleryContractVersion", "releaseDigest", "releaseLockSha256", "productionPin", "errorCodes", "remediation"],
      "propertyNames": { "enum": ["runtimeRoot", "installSource", "skillVersion", "artifactSchemaVersion", "galleryContractVersion", "releaseDigest", "releaseLockSha256", "productionPin", "errorCodes", "remediation"] }
    },
    "installRecordFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["skillVersion", "releaseDigest", "packageSource", "installedPath"],
      "propertyNames": { "enum": ["skillVersion", "releaseDigest", "packageSource", "installedPath"] }
    },
    "migrationFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["artifactType", "revision", "oldPinSha256", "newPinSha256", "oldPin", "newPin", "changedVersionLines", "invalidateFromPhase", "productionItemId", "templateRevision", "productionManifestSha256"],
      "propertyNames": { "enum": ["artifactType", "revision", "oldPinSha256", "newPinSha256", "oldPin", "newPin", "changedVersionLines", "invalidateFromPhase", "productionItemId", "templateRevision", "productionManifestSha256"] }
    },
    "productionPinFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["artifactType", "schemaVersion", "skill", "artifactSchemaVersion", "releaseSha256", "releaseManifestSha256", "releaseFileCount", "machineRulesSha256", "gitCommit", "validatorSha256", "replacementSpecVersion", "replacementSpecSha256", "galleryContract"],
      "propertyNames": { "enum": ["artifactType", "schemaVersion", "skill", "artifactSchemaVersion", "releaseSha256", "releaseManifestSha256", "releaseFileCount", "machineRulesSha256", "gitCommit", "validatorSha256", "replacementSpecVersion", "replacementSpecSha256", "galleryContract"] }
    },
    "productionPinSkillFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["name", "version"],
      "propertyNames": { "enum": ["name", "version"] }
    },
    "productionPinGalleryFields": {
      "$ref": "#/$defs/roleMap",
      "required": ["id", "snapshot", "sha256", "upstreamSourceSha256"],
      "propertyNames": { "enum": ["id", "snapshot", "sha256", "upstreamSourceSha256"] }
    },
    "installLayout": {
      "$ref": "#/$defs/roleMap",
      "required": ["versionsDirectory", "currentPointer", "recordsDirectory"],
      "propertyNames": { "enum": ["versionsDirectory", "currentPointer", "recordsDirectory"] }
    },
    "roleMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
    }
  }
}
