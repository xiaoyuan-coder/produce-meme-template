{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.internal/schemas/gallery-template-import.json",
  "title": "GalleryTemplateImport",
  "description": "批量导入 memebuy 后端 GalleryTemplate 表的单模板文件契约。图片字段给本地路径（CLI 会上传 OSS 后回填为 *Url 列）或 http(s) URL（直通不重传）。带 export 标记的键是后台导出才产出的可选键，手写文件不必带；带了才生效，不带一律沿用库里旧值。",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "title", "promptTemplate", "inputSchema"],
  "properties": {
    "id": {
      "type": ["string", "null"],
      "description": "【后台导出产出，可选】库内主键。导入时优先按它匹配，能识别出「同一条模板改了 key」；跨环境（UAT→生产）必然对不上，自动回落 (社区, key) 匹配。不会被写库。"
    },
    "communityKey": {
      "type": ["string", "null"],
      "description": "【后台导出产出，可选】所属社区的 key（不是 id——id 跨环境不通用）。只有后台导入认这个键；CLI 一律用 --community 参数。缺省时落到导入弹窗选的默认社区，两者都没有则该条判失败。本环境查无此社区也判失败（不自动建社区）。"
    },
    "status": {
      "type": ["string", "null"],
      "enum": ["DRAFT", "PUBLISHED", "ARCHIVED", null],
      "description": "【后台导出产出，可选】上下架状态。带了就按它落；不带则默认 PUBLISHED，且 metadata.needsReview 非空时强降 DRAFT。"
    },
    "sortOrder": {
      "type": ["integer", "null"],
      "description": "【后台导出产出，可选】人工排序值。不写这个键就不动库里的现有排序。"
    },
    "makerKey": {
      "type": ["string", "null"],
      "maxLength": 60,
      "description": "【后台导出产出，可选】归属的 maker（小工具）。不写这个键就不动库里的归属；显式写 null 才是清空。写错会让 maker 模板脱离 maker、混进 C 端公开模板目录。"
    },
    "featureKeys": {
      "type": ["array", "null"],
      "items": { "type": "string", "maxLength": 60 },
      "description": "【后台导出产出，可选】所属专题的 key 列表（不是 id）。导入时按 key 挂回，**只加不减**：本环境已有、文件里没写的归属会保留。key 在本环境不存在只 warn 不拦。"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,59}$",
      "description": "业务唯一键（upsert 依据）。小写字母开头，仅小写字母/数字/连字符，2-60 字符。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "模板标题。"
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 300,
      "description": "模板简介，超长请截断到 300 字符。"
    },
    "cover": {
      "type": ["string", "null"],
      "description": "封面图【本地文件路径】。导入脚本传 OSS 后回填到 DB 列 coverUrl。"
    },
    "referenceImage": {
      "type": ["string", "null"],
      "description": "模板自带参考图【本地文件路径】，作为生成的固定参考图（DB 列 templateImageUrl）。注意：这是模板级的一张固定图，与 inputSchema 里的 image 输入槽（终端用户上传）完全无关。"
    },
    "imageSize": {
      "type": "string",
      "pattern": "^\\d{2,4}x\\d{2,4}$",
      "default": "1024x1024",
      "description": "出图尺寸，形如 1024x1024。"
    },
    "imageN": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "单次出图张数。"
    },
    "stageKey": {
      "type": ["string", "null"],
      "maxLength": 60,
      "description": "生成能力 stage 标识（可空）。"
    },
    "promptTemplate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "提示词模板【可执行字段，语法固定】。占位为兜底链：{{ term | term | \"字面量默认\" }}，从左到右取第一个非空项。term 是点路径：{{inputId}} 取该输入值；{{selectId.key}} 取选中项 payload[key]；{{stepId.field}} 取预处理步产出的 JSON 字段。双引号内是字面量兜底。所有 term 引用的 head id 必须在 inputSchema 或 preprocessSteps 中已定义。"
    },
    "promptEnhancement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stageKey", "instruction", "output"],
      "description": "【可执行字段，结构固定】v2 提示词增强层：落定 promptTemplate 后再交文本模型改写一次。省略则运行时回落全局默认 merge。",
      "properties": {
        "stageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "改写用的 stage（如 gallery.prompt_rewrite）。必须是运维已在 AiStageBinding 绑好的 stage。"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "内部改写目标（不得改变用户创作意图）。"
        },
        "referenceField": {
          "type": "string",
          "enum": ["referenceImage"],
          "description": "存在模板参考图时固定填 referenceImage。"
        },
        "lockedConstraints": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "description": "最终提示词必须执行的结构/风格硬约束。"
        },
        "preserve": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": "必须保留的语义锚点。"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "promptField"],
          "description": "输出契约固定，照抄即可。",
          "properties": {
            "format": { "type": "string", "enum": ["json"] },
            "promptField": { "type": "string", "enum": ["finalPrompt"] }
          }
        }
      }
    },
    "inputSchema": {
      "type": "array",
      "maxItems": 20,
      "default": [],
      "description": "终端用户填写的输入槽【可执行字段，结构固定】。判别联合，按 type 分 prompt/select/image/subject 四类。数组内 id 唯一。",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/promptInput" },
          { "$ref": "#/$defs/selectInput" },
          { "$ref": "#/$defs/imageInput" },
          { "$ref": "#/$defs/subjectInput" }
        ]
      }
    },
    "preprocessSteps": {
      "type": "array",
      "maxItems": 4,
      "default": [],
      "description": "AI 预处理步【可执行字段，结构固定】。worker 侧异步执行，产出 JSON 供 {{stepId.field}} 引用。无预处理给 []。step id 与 inputSchema 的 id 共享命名空间、不得撞名。判别联合 vision/text。",
      "items": {
        "oneOf": [{ "$ref": "#/$defs/visionStep" }, { "$ref": "#/$defs/textStep" }]
      }
    },
    "metadata": {
      "type": "object",
      "description": "所有我方没有专列的模板元数据整包存这里（DB 列 metadata Json?，原样保存、零丢失）。Agent 觉得有价值的分类/风格/版本等都放这。约定额外铺一个扁平 tags 数组，供未来筛选/再识别。",
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "扁平标签数组（从分类体系铺平），未来按 metadata.tags 筛选。"
        },
        "needsReview": {
          "type": ["string", "null"],
          "description": "把握不准/需人工复核的模板在此写原因（非空字符串）。导入脚本读到非空 → 强制该模板 status=DRAFT，不上线（其余默认 PUBLISHED）。"
        },
        "editablePrompt": {
          "type": ["string", "null"],
          "description": "可选：人类可读的提示词预览原文（无占位）。仅留档展示用，不参与生成——生成只跑 promptTemplate。"
        },
        "templateSource": {
          "type": ["object", "null"],
          "description": "可选：原图的结构/构图信息留档。注意：这里只是留档，任何必须生效的硬约束（构图、锁定项）都要同时写进 promptTemplate，否则不会作用于生成。",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "inputId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$",
      "description": "输入/步骤 id：字母开头，仅字母/数字/下划线/连字符，最长 40。"
    },
    "promptInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "const": "prompt" },
        "id": { "$ref": "#/$defs/inputId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "placeholder": { "type": "string", "maxLength": 120, "default": "" },
        "required": { "type": "boolean", "default": false },
        "suggestions": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 120 },
          "description": "可选的输入建议词。"
        }
      }
    },
    "selectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label", "options"],
      "properties": {
        "type": { "const": "select" },
        "id": { "$ref": "#/$defs/inputId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "required": { "type": "boolean", "default": false },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/selectOption" }
        }
      }
    },
    "selectOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "选中后由 {{selectId}} 注入 prompt 的文本，可写成描述性文案。"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "给用户看的选项名。"
        },
        "thumbnail": {
          "type": "string",
          "format": "uri",
          "maxLength": 500,
          "description": "可选缩略图 URL。"
        },
        "payload": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 4000 },
          "description": "选中项的具名附加值：{{selectId.key}} 取 payload[key]（如每个 MBTI code 带 fusion 风格段 + subtitle 副标题）。"
        }
      }
    },
    "imageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label"],
      "description": "图片输入槽 = 终端用户上传的图（运行时值为 assetId 数组）。不要在这里放模板自带图路径，那个用顶层 referenceImage。",
      "properties": {
        "type": { "const": "image" },
        "id": { "$ref": "#/$defs/inputId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "hint": {
          "type": "string",
          "maxLength": 120,
          "default": "",
          "description": "上传引导文案，如「请上传正脸清晰照」。"
        },
        "required": { "type": "boolean", "default": false },
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 1,
          "description": "最多可传图片数，1 = 单图。"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192,
          "description": "可选最低宽度像素。"
        },
        "minHeight": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192,
          "description": "可选最低高度像素。"
        },
        "private": {
          "type": "boolean",
          "default": false,
          "description": "人脸等敏感图置 true → 走私读桶。"
        }
      }
    },
    "subjectTextConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultValue", "suggestions"],
      "properties": {
        "defaultValue": { "type": "string", "minLength": 1, "maxLength": 120 },
        "placeholder": { "type": "string", "maxLength": 120, "default": "" },
        "allowCustom": { "type": "boolean", "default": true },
        "suggestions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "subjectImageConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "promptValue", "extract", "sourceOptions"],
      "properties": {
        "enabled": { "const": true },
        "promptValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "图片模式下由 {{subjectId}} 注入 prompt 的中性主体描述。"
        },
        "hint": { "type": "string", "maxLength": 120, "default": "" },
        "extract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "主体身份抽取语义留档。"
        },
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 1
        },
        "minWidth": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "minHeight": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "private": { "type": "boolean", "default": false },
        "sourceOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["upload", "recent_upload", "asset_library"]
          }
        }
      }
    },
    "subjectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "label", "text", "image", "resolutionStrategy"],
      "description": "文本/图片二选一的复合主体。图片存在时按 image_over_text 覆盖文本，并把原图作为带 inputId 的身份参考图直通生成模型。",
      "properties": {
        "type": { "const": "subject" },
        "id": { "$ref": "#/$defs/inputId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "required": { "type": "boolean", "default": false },
        "text": { "$ref": "#/$defs/subjectTextConfig" },
        "image": { "$ref": "#/$defs/subjectImageConfig" },
        "resolutionStrategy": { "const": "image_over_text" }
      }
    },
    "visionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "stageKey", "imageInputId", "prompt"],
      "description": "视觉预处理：读某 image 或 subject 图片输入 → 视觉模型按 prompt 提取 → 产出 JSON（{{stepId.field}} 引用）。",
      "properties": {
        "type": { "const": "vision" },
        "id": {
          "$ref": "#/$defs/inputId",
          "description": "步骤 id = 产出变量名。"
        },
        "stageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "视觉能力 AI stage，如 meme.avatar_vl。"
        },
        "imageInputId": {
          "$ref": "#/$defs/inputId",
          "description": "喂给它的 image 输入槽 id，必须指向已定义的 image 槽。"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "提取指令，本身也可含 {{输入}}。"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "cache": { "type": "boolean", "default": true }
      }
    },
    "textStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "stageKey", "prompt"],
      "description": "文本改写预处理：按 prompt 改写/扩写文本 → 产出 JSON（{{stepId.field}} 引用）。",
      "properties": {
        "type": { "const": "text" },
        "id": {
          "$ref": "#/$defs/inputId",
          "description": "步骤 id = 产出变量名。"
        },
        "stageKey": { "type": "string", "minLength": 1, "maxLength": 60 },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "改写指令，可含 {{输入}} 与 {{前序步骤.field}}。"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "cache": { "type": "boolean", "default": true }
      }
    }
  }
}
